@model IEnumerable<TP02.Models.BL>

@{
    ViewData["Title"] = "Gestão de Bill of Ladings";
}

<div class="card">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h5 class="card-title mb-0 text-secondary">Lista de BLs Cadastrados</h5>
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-lg"></i> Novo BL
            </a>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>@Html.DisplayNameFor(model => model.Numero)</th>
                        <th>@Html.DisplayNameFor(model => model.Consignee)</th>
                        <th>@Html.DisplayNameFor(model => model.Navio)</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted py-4">Nenhum BL cadastrado até o momento.</td>
                        </tr>
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold">@Html.DisplayFor(modelItem => item.Numero)</td>
                            <td>@Html.DisplayFor(modelItem => item.Consignee)</td>
                            <td>@Html.DisplayFor(modelItem => item.Navio)</td>
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary me-1" title="Editar">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Excluir">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>