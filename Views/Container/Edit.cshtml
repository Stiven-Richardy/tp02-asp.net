@model TP02.Models.Container

@{
    ViewData["Title"] = "Editar Container";
}

<div class="card" style="max-width: 600px; margin: 0 auto;">
    <div class="card-body p-4">
        <h5 class="card-title mb-4 text-secondary">Atualizar dados do Container</h5>

        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label asp-for="BLId" class="form-label fw-bold"></label>
                <select asp-for="BLId" class="form-select" asp-items="ViewBag.BLId"></select>
                <span asp-validation-for="BLId" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Numero" class="form-label fw-bold"></label>
                <input asp-for="Numero" class="form-control" placeholder="Ex: ABCD1234567 (4 letras e 7 números)" autocomplete="off" maxlength="11" />
                <span asp-validation-for="Numero" class="text-danger small"></span>
            </div>

            <div class="row mb-4">
                <div class="col-md-6">
                    <label asp-for="Tipo" class="form-label fw-bold"></label>
                    <select asp-for="Tipo" class="form-select">
                        <option value="Dry">Dry (Carga Seca)</option>
                        <option value="Reefer">Reefer (Refrigerado)</option>
                    </select>
                    <span asp-validation-for="Tipo" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Tamanho" class="form-label fw-bold"></label>
                    <select asp-for="Tamanho" class="form-select">
                        <option value="20">20 Pés</option>
                        <option value="40">40 Pés</option>
                    </select>
                    <span asp-validation-for="Tamanho" class="text-danger small"></span>
                </div>
            </div>

            <div class="d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-light border">Cancelar</a>
                <button type="submit" class="btn btn-primary">Salvar Alterações</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}